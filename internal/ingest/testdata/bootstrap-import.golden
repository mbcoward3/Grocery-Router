recipe_steps {"id": 1, "position": 0, "section_id": 1, "instruction": "Heat a large covered pan over high heat. Add the roast and turn it until deeply browned on all sides."}
recipe_steps {"id": 2, "position": 1, "section_id": 1, "instruction": "Add enough water to reach about two-thirds of the way up the roast. Sprinkle with the onion soup mix and pour in the liquid from the pepperoncini jar."}
recipe_steps {"id": 3, "position": 2, "section_id": 1, "instruction": "Bring to a boil, reduce the heat to a simmer, cover, and cook for about 2 hours, turning occasionally, until the beef is tender enough to pull apart. Add water if needed to keep the braising liquid from drying out."}
recipe_steps {"id": 4, "position": 3, "section_id": 1, "instruction": "Shred or thinly slice the beef and return it to the cooking liquid. Add pepperoncini as desired."}
recipe_steps {"id": 5, "position": 4, "section_id": 1, "instruction": "Place provolone slices on the split buns and broil on a baking sheet until the cheese melts and the buns are lightly toasted, watching carefully. Fill with beef and serve with the cooking liquid for dipping."}
recipe_steps {"id": 6, "position": 0, "section_id": 2, "instruction": "Season the roast with kosher salt, black pepper, and thyme. Heat the vegetable oil over medium-high heat and brown the roast deeply for 4 to 5 minutes per side."}
recipe_steps {"id": 7, "position": 1, "section_id": 2, "instruction": "Place the carrots, potatoes, and garlic in the slow cooker. Set the browned roast on top, add the beef broth, and cover."}
recipe_steps {"id": 8, "position": 2, "section_id": 2, "instruction": "Cook on low for 8 hours."}
recipe_steps {"id": 9, "position": 3, "section_id": 2, "instruction": "During the final hour, stir the cornstarch and cold water into a smooth slurry and add it to the slow cooker to thicken the cooking liquid."}
recipe_steps {"id": 10, "position": 4, "section_id": 2, "instruction": "Serve the tender roast and vegetables with the thickened liquid and parsley if desired."}
recipe_steps {"id": 11, "position": 0, "section_id": 3, "instruction": "Preheat the oven to 325°F and position a rack in the lower-middle position."}
recipe_steps {"id": 12, "position": 1, "section_id": 3, "instruction": "Pat the beef dry and season with salt and black pepper. Heat 1 tablespoon olive oil in a Dutch oven over medium-high heat. Brown the beef in three batches for about 5 minutes per batch, adding another tablespoon of oil for each batch, then transfer it to a plate."}
recipe_steps {"id": 13, "position": 2, "section_id": 3, "instruction": "Add the onions, garlic, and balsamic vinegar. Cook while scraping up the browned bits for about 5 minutes. Add the tomato paste and cook for 1 minute."}
recipe_steps {"id": 14, "position": 3, "section_id": 3, "instruction": "Return the beef and its juices to the pot, sprinkle with flour, and stir for 1 to 2 minutes. Add the wine, beef broth, water, bay leaf, thyme, and sugar. Bring to a boil."}
recipe_steps {"id": 15, "position": 4, "section_id": 3, "instruction": "Cover and braise in the oven for 2 hours. Add the carrots and potatoes, cover again, and cook for about 1 more hour, until the vegetables and beef are tender. Discard the bay leaf, adjust seasoning, and garnish with parsley if desired."}
recipe_steps {"id": 16, "position": 0, "section_id": 4, "instruction": "Bake the biscuits according to their package directions."}
recipe_steps {"id": 17, "position": 1, "section_id": 4, "instruction": "While the biscuits bake, cook the breakfast sausage and onion in a large skillet over medium heat, breaking up the sausage, until browned and cooked through."}
recipe_steps {"id": 18, "position": 2, "section_id": 4, "instruction": "Stir in the butter, then sprinkle in the flour and cook for 1 minute."}
recipe_steps {"id": 19, "position": 3, "section_id": 4, "instruction": "Gradually stir in the milk. Simmer, stirring often, until the gravy thickens, then season with salt and black pepper."}
recipe_steps {"id": 20, "position": 4, "section_id": 4, "instruction": "Split the warm biscuits and spoon the sausage gravy over them."}
recipe_steps {"id": 21, "position": 0, "section_id": 5, "instruction": "Cook the bacon until crisp, then drain it."}
recipe_steps {"id": 22, "position": 1, "section_id": 5, "instruction": "Toast the bread if desired."}
recipe_steps {"id": 23, "position": 2, "section_id": 5, "instruction": "Spread mayonnaise on the bread and layer with lettuce, sliced tomato, and bacon."}
recipe_steps {"id": 24, "position": 3, "section_id": 5, "instruction": "Close the sandwiches and serve."}
recipe_steps {"id": 25, "position": 0, "section_id": 6, "instruction": "Preheat the oven to 375°F."}
recipe_steps {"id": 26, "position": 1, "section_id": 6, "instruction": "Boil the elbow pasta in water until just al dente according to the package directions, then drain."}
recipe_steps {"id": 27, "position": 2, "section_id": 6, "instruction": "While the pasta cooks, brown the ground beef in a large skillet over medium-high heat, breaking it into crumbles. Drain excess fat."}
recipe_steps {"id": 28, "position": 3, "section_id": 6, "instruction": "Reduce the heat and stir the marinara, cream cheese, Italian seasoning, salt, and black pepper into the beef until the cream cheese melts and the sauce is smooth."}
recipe_steps {"id": 29, "position": 4, "section_id": 6, "instruction": "Combine the drained pasta with the beef sauce and transfer to a baking dish. Top evenly with the shredded cheese."}
recipe_steps {"id": 30, "position": 5, "section_id": 6, "instruction": "Bake uncovered for 20 to 25 minutes, until hot and bubbly and the cheese is melted."}
recipe_steps {"id": 31, "position": 0, "section_id": 7, "instruction": "Heat the oven to 375°F and coat a 9×13-inch baking dish with nonstick cooking spray."}
recipe_steps {"id": 32, "position": 1, "section_id": 7, "instruction": "Whisk the cream of chicken soup, milk, garlic powder, rotisserie seasoning, and black pepper until mostly smooth."}
recipe_steps {"id": 33, "position": 2, "section_id": 7, "instruction": "Separate the biscuits, cut each into quarters, and stir them into the soup mixture."}
recipe_steps {"id": 34, "position": 3, "section_id": 7, "instruction": "Fold in the peas and carrots, cheddar, and chicken, then spread the mixture in the prepared dish."}
recipe_steps {"id": 35, "position": 4, "section_id": 7, "instruction": "Bake uncovered on the middle rack for 35–45 minutes, until the biscuits are golden and the filling bubbles at the edges."}
recipe_steps {"id": 36, "position": 5, "section_id": 7, "instruction": "If the center needs more time, cover the top with foil and continue baking. Cool briefly, top with optional green onion, and serve."}
recipe_steps {"id": 37, "position": 0, "section_id": 8, "instruction": "Place the chicken, undrained Rotel, undrained corn, drained pinto and black beans, onion, chicken broth, chili powder, cumin, salt, black pepper, ranch seasoning, and cream cheese in a slow cooker."}
recipe_steps {"id": 38, "position": 1, "section_id": 8, "instruction": "Cover and cook on high for 4 hours."}
recipe_steps {"id": 39, "position": 2, "section_id": 8, "instruction": "Remove the chicken, shred it, return it to the slow cooker, and stir until the cream cheese is incorporated before serving."}
recipe_steps {"id": 40, "position": 0, "section_id": 9, "instruction": "Add the chicken broth, water, carrots, celery, onion, and garlic to a large soup pot and bring to a boil over medium-high heat."}
recipe_steps {"id": 41, "position": 1, "section_id": 9, "instruction": "Reduce to a steady simmer and cook for 12 to 15 minutes, until the vegetables are tender."}
recipe_steps {"id": 42, "position": 2, "section_id": 9, "instruction": "Add the cooked shredded chicken and return the soup to a simmer."}
recipe_steps {"id": 43, "position": 3, "section_id": 9, "instruction": "Discard the ramen seasoning packets. Add the noodles and cook for about 3 minutes, or according to the package directions, until tender."}
recipe_steps {"id": 44, "position": 4, "section_id": 9, "instruction": "Remove from the heat, separate the noodles with a spoon, and serve."}
recipe_steps {"id": 45, "position": 0, "section_id": 10, "instruction": "Heat 1 tablespoon of the cooking oil in a large pan over medium-high heat. Add the chicken, season with salt and black pepper, and sauté until cooked through and browned. Remove the chicken and set aside."}
recipe_steps {"id": 46, "position": 1, "section_id": 10, "instruction": "Heat another 1 tablespoon cooking oil in the same pan and add the mushrooms. When they begin to soften, add the broccoli and stir-fry until tender. Remove the vegetables and set aside."}
recipe_steps {"id": 47, "position": 2, "section_id": 10, "instruction": "Add the final 1 tablespoon cooking oil to the pan and sauté the garlic and ginger until fragrant."}
recipe_steps {"id": 48, "position": 3, "section_id": 10, "instruction": "Add the sesame oil, reduced-sodium soy sauce, brown sugar, chicken broth, and flour. Stir until the sauce is smooth."}
recipe_steps {"id": 49, "position": 4, "section_id": 10, "instruction": "Return the chicken and vegetables to the pan and stir until heated through."}
recipe_steps {"id": 50, "position": 5, "section_id": 10, "instruction": "Serve with hot rice."}
recipe_steps {"id": 51, "position": 0, "section_id": 11, "instruction": "In a Dutch oven or soup pot over medium heat, cook the ground beef and onion for about 5 minutes, stirring occasionally, until the onion is translucent and the beef is cooked through. Add the garlic during the final minute, then drain the grease."}
recipe_steps {"id": 52, "position": 1, "section_id": 11, "instruction": "Add the beef broth, chili beans, tomato sauce, chili powder, cumin, garlic salt, oregano, tomato paste, and diced tomatoes. Stir, bring to a low boil, reduce the heat to low, and simmer uncovered for 20 minutes, stirring occasionally."}
recipe_steps {"id": 53, "position": 2, "section_id": 11, "instruction": "Remove from the heat and let stand for 5 to 10 minutes. Serve with sour cream and shredded cheese if desired."}
recipe_steps {"id": 54, "position": 0, "section_id": 12, "instruction": "Place the chuck roast in the bottom of a 6-quart slow cooker and sprinkle with the Italian salad dressing mix."}
recipe_steps {"id": 55, "position": 1, "section_id": 12, "instruction": "Add 8 ounces sliced pepperoncini with a splash of juice, 8 ounces drained giardiniera, and the beef broth. Lift the roast pieces so broth gets underneath them."}
recipe_steps {"id": 56, "position": 2, "section_id": 12, "instruction": "Cover and cook on low for 9 hours, or until the meat shreds easily with a fork."}
recipe_steps {"id": 57, "position": 3, "section_id": 12, "instruction": "Shred the meat, return it to the juices in the slow cooker, and cook on low for 1 more hour."}
recipe_steps {"id": 58, "position": 4, "section_id": 12, "instruction": "Split the buns and fill them with shredded beef. Add provolone and, if desired, extra pepperoncini and giardiniera, then serve."}
recipe_steps {"id": 59, "position": 0, "section_id": 13, "instruction": "Preheat the oven to 400°F and line a baking sheet with parchment paper."}
recipe_steps {"id": 60, "position": 1, "section_id": 13, "instruction": "Add the potatoes to the baking sheet, season with olive oil, dried thyme, salt, and black pepper, and bake for 20 minutes."}
recipe_steps {"id": 61, "position": 2, "section_id": 13, "instruction": "Stir together the lemon juice, garlic, onion powder, paprika, dried thyme, dried parsley, and honey to make the salmon marinade."}
recipe_steps {"id": 62, "position": 3, "section_id": 13, "instruction": "Push the potatoes to one side of the baking sheet and add the salmon and asparagus."}
recipe_steps {"id": 63, "position": 4, "section_id": 13, "instruction": "Season the salmon and asparagus with olive oil, salt, and black pepper, then brush the marinade over the salmon."}
recipe_steps {"id": 64, "position": 5, "section_id": 13, "instruction": "Top the salmon with the lemon slices and fresh thyme sprigs."}
recipe_steps {"id": 65, "position": 6, "section_id": 13, "instruction": "Bake for 12 to 14 minutes, or until the salmon is cooked."}
recipe_steps {"id": 66, "position": 0, "section_id": 14, "instruction": "Preheat the oven to 350°F and lightly coat a 9×13-inch baking dish with nonstick cooking spray."}
recipe_steps {"id": 67, "position": 1, "section_id": 14, "instruction": "Brown the ground beef in a large skillet over medium-high heat. Drain the excess fat, return the skillet to medium-low heat, stir in the salsa, and cook until heated through."}
recipe_steps {"id": 68, "position": 2, "section_id": 14, "instruction": "Pour half of the enchilada sauce into the prepared baking dish and warm the tortillas according to their package directions."}
recipe_steps {"id": 69, "position": 3, "section_id": 14, "instruction": "Place about ¼ cup meat mixture and 1 heaping tablespoon cheese down the center of each tortilla. Roll tightly and arrange seam-side down in the dish."}
recipe_steps {"id": 70, "position": 4, "section_id": 14, "instruction": "Pour the remaining enchilada sauce over the tortillas and sprinkle with the remaining cheese. Cover tightly with aluminum foil and bake for 30 to 35 minutes."}
recipe_steps {"id": 71, "position": 0, "section_id": 15, "instruction": "Divide the ground beef into patties of the preferred size, handling the meat lightly. Press a shallow indentation into the center of each patty."}
recipe_steps {"id": 72, "position": 1, "section_id": 15, "instruction": "Sprinkle the tops of the patties with salt, black pepper, and garlic powder."}
recipe_steps {"id": 73, "position": 2, "section_id": 15, "instruction": "Heat a grill or skillet over medium-high heat."}
recipe_steps {"id": 74, "position": 3, "section_id": 15, "instruction": "Cook the patties until browned on the first side, then flip and continue cooking until the centers reach 160°F. Add Colby Jack during the final minute for any cheeseburgers."}
recipe_steps {"id": 75, "position": 4, "section_id": 15, "instruction": "Briefly toast the cut sides of the buns on the grill or skillet if desired."}
recipe_steps {"id": 76, "position": 5, "section_id": 15, "instruction": "Serve on buns with onion rings, mayonnaise, mustard, and ketchup."}
recipe_steps {"id": 77, "position": 0, "section_id": 16, "instruction": "Preheat the oven to 350°F. Combine the meatball ingredients, shape into 1-inch balls, place on a parchment-lined pan, and bake for 20 minutes or until cooked through. For a shortcut, 16 frozen meatballs can be prepared according to their package directions instead."}
recipe_steps {"id": 78, "position": 1, "section_id": 16, "instruction": "Simmer the cooked meatballs in the marinara sauce, covered, for 10 minutes."}
recipe_steps {"id": 79, "position": 2, "section_id": 16, "instruction": "Spread garlic butter inside each roll and broil for about 3 minutes, until golden."}
recipe_steps {"id": 80, "position": 3, "section_id": 16, "instruction": "Place four meatballs in each roll, add sauce and cheese, and broil for 2 to 3 minutes until melted. Serve with additional sauce if desired."}
recipe_steps {"id": 81, "position": 0, "section_id": 17, "instruction": "Line a rimmed baking sheet with parchment paper or foil and preheat the oven to 350°F."}
recipe_steps {"id": 82, "position": 1, "section_id": 17, "instruction": "Heat the olive oil in a medium skillet over medium heat. Add the onion and sauté, stirring occasionally, until softened and golden, about 5 to 7 minutes. Transfer to a plate to cool."}
recipe_steps {"id": 83, "position": 2, "section_id": 17, "instruction": "In a large bowl, combine the ground beef, eggs, garlic, 2 tablespoons ketchup, parsley, panko, milk, salt, Italian seasoning, black pepper, and cooled onion. Mix just until combined."}
recipe_steps {"id": 84, "position": 3, "section_id": 17, "instruction": "Shape the mixture on the prepared pan into a loaf about 8 inches long, 4 inches wide, and 3 inches tall. Bake uncovered for 40 minutes."}
recipe_steps {"id": 85, "position": 4, "section_id": 17, "instruction": "Stir together the sauce ingredients in a small bowl."}
recipe_steps {"id": 86, "position": 5, "section_id": 17, "instruction": "Spread the sauce over the meatloaf. Bake for another 20 minutes, or until the center reaches 160°F. Rest for 10 to 15 minutes before slicing."}
recipe_steps {"id": 87, "position": 0, "section_id": 18, "instruction": "Preheat the oven to 375°F and place the pork loin in a baking dish."}
recipe_steps {"id": 88, "position": 1, "section_id": 18, "instruction": "Bake for 45 to 60 minutes, until the thickest part reaches 145°F."}
recipe_steps {"id": 89, "position": 2, "section_id": 18, "instruction": "Remove the pork from the oven and let it rest for at least 3 minutes before slicing."}
recipe_steps {"id": 90, "position": 3, "section_id": 18, "instruction": "While the pork bakes, cook 2 cups uncooked white rice with water according to the rice package directions."}
recipe_steps {"id": 91, "position": 4, "section_id": 18, "instruction": "Serve the sliced pork with the cooked rice and add soy sauce to the rice as desired."}
recipe_steps {"id": 92, "position": 0, "section_id": 19, "instruction": "Steam the sausages in a covered frying pan. Let them cool for at least 1 hour so the pork fat congeals and the juices are not lost when they are cut."}
recipe_steps {"id": 93, "position": 1, "section_id": 19, "instruction": "Cut the cooled sausages into bite-size pieces."}
recipe_steps {"id": 94, "position": 2, "section_id": 19, "instruction": "Heat olive oil in a frying pan to 365°F (185°C). Add the sliced onion and cook until light golden brown."}
recipe_steps {"id": 95, "position": 3, "section_id": 19, "instruction": "Add the sausage pieces. When they begin to brown, add the green and red peppers, fresh thyme, fresh rosemary, salt, and black pepper. Cook until the peppers are tender."}
recipe_steps {"id": 96, "position": 4, "section_id": 19, "instruction": "Add the chopped garlic and sauté for 1 minute, then remove from the heat."}
recipe_steps {"id": 97, "position": 0, "section_id": 20, "instruction": "Preheat the oven to 350°F and butter a rimmed baking sheet."}
recipe_steps {"id": 98, "position": 1, "section_id": 20, "instruction": "Heat the olive oil in a large skillet over medium-high heat. Add the onion and ground beef, season with salt, black pepper, and garlic powder, and cook until the beef is just cooked through. Drain excess fat and stir in the mayonnaise."}
recipe_steps {"id": 99, "position": 2, "section_id": 20, "instruction": "Split the rolls as a connected slab. Place the bottoms on the pan, layer with sliced cheddar, spread on the beef mixture, and top with shredded cheddar."}
recipe_steps {"id": 100, "position": 3, "section_id": 20, "instruction": "Add the roll tops, brush with melted butter, and sprinkle with sesame seeds. Bake for 12 to 15 minutes, until golden and melted."}
recipe_steps {"id": 101, "position": 0, "section_id": 21, "instruction": "Brown the ground beef in a skillet over medium-high heat, breaking it into crumbles, until cooked through. Drain excess fat."}
recipe_steps {"id": 102, "position": 1, "section_id": 21, "instruction": "Stir in the taco seasoning and ⅔ cup water. Cook, stirring, until the sauce thickens and coats the beef."}
recipe_steps {"id": 103, "position": 2, "section_id": 21, "instruction": "Warm the flour tortillas according to their package directions."}
recipe_steps {"id": 104, "position": 3, "section_id": 21, "instruction": "Serve the taco meat in warm tortillas with shredded cheese, chopped onion, sour cream, avocado, and mild or hot taco sauce."}
recipe_steps {"id": 105, "position": 0, "section_id": 22, "instruction": "Heat a large nonstick pan over medium-high heat. Add the chicken and quickly sear until golden brown on both sides."}
recipe_steps {"id": 106, "position": 1, "section_id": 22, "instruction": "Add the soy sauce and brown sugar and stir to combine, then bring to a boil. Cook until the sauce reduces and coats the chicken."}
recipe_steps {"id": 107, "position": 2, "section_id": 22, "instruction": "Serve with rice, if desired."}
recipe_steps {"id": 108, "position": 0, "section_id": 23, "instruction": "Combine the tuna, mayonnaise, yellow mustard, chopped pickles, pickle juice, pepperoncini, diced red onion, optional celery seed, salt, and a generous amount of black pepper until creamy but still textured."}
recipe_steps {"id": 109, "position": 1, "section_id": 23, "instruction": "Assemble four sandwiches by layering bread with tuna mixture, pickle slices, thinly sliced red onion, cheddar, and top bread."}
recipe_steps {"id": 110, "position": 2, "section_id": 23, "instruction": "Melt butter in a cast-iron skillet over medium heat. Working in batches as needed, add the sandwiches, press lightly, and cook until golden."}
recipe_steps {"id": 111, "position": 3, "section_id": 23, "instruction": "Flip, cover the skillet, and continue cooking until the second sides are golden and the cheese is melted."}
recipe_steps {"id": 112, "position": 0, "section_id": 24, "instruction": "Brown the sausage in a large soup pot over medium-high heat, breaking it up, then drain excess fat."}
recipe_steps {"id": 113, "position": 1, "section_id": 24, "instruction": "Add the onion, garlic, basil, oregano, thyme, and optional crushed red pepper. Cook until the onion is soft and translucent."}
recipe_steps {"id": 114, "position": 2, "section_id": 24, "instruction": "Add the potatoes, chicken broth, coconut milk, and salt. Simmer for 20 to 25 minutes, until the potatoes are soft."}
recipe_steps {"id": 115, "position": 3, "section_id": 24, "instruction": "Stir the cornstarch and water into a smooth slurry, add it to the soup, and stir."}
recipe_steps {"id": 116, "position": 4, "section_id": 24, "instruction": "Add the kale and cook for 15 minutes more, until tender and the soup is slightly thickened."}
