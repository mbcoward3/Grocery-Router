# Copy to .env.vps, replace every placeholder, then chmod 600 .env.vps.
# Use the complete tag@digest reference printed by the successful main workflow.
GROCERY_ROUTER_IMAGE=ghcr.io/mbcoward3/grocery-router:sha-REPLACE_WITH_40_CHARACTER_COMMIT@sha256:REPLACE_WITH_64_CHARACTER_DIGEST

# Existing DNS A/AAAA record; this project does not provision a domain.
GROCERY_ROUTER_DOMAIN=router.example.invalid
GROCERY_ROUTER_ACME_EMAIL=operator@example.invalid

# Run `id -u` and `id -g` as the unprivileged VPS operator.
GROCERY_ROUTER_RUNTIME_UID=1000
GROCERY_ROUTER_RUNTIME_GID=1000

# Owner-readable file containing only the CockroachDB connection URL. Keep
# sslmode=verify-full and URL-encode special characters in credentials.
GROCERY_ROUTER_DATABASE_URL_FILE=./.local/secrets/database-url

# Omit this variable to keep the deny-all default. Set it only to a private Caddy
# authentication snippet approved by the pending auth review.
# GROCERY_ROUTER_AUTH_CADDYFILE=./.local/secrets/auth.caddy
